{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hackathon-kit/os/estado/v1",
  "title": "Estado proyectado del equipo (v1)",
  "description": "Lo calcula el relay. Web, estado-equipo.md y MCP salen solo de aquí. Todo dato observado va como Dato {valor, fuente, observado_en}. Los estados de tarea son identificadores; las vistas muestran su etiqueta legible.",
  "type": "object",
  "required": ["v", "generado_en", "fuentes", "personas", "tareas", "colisiones"],
  "additionalProperties": false,
  "$defs": {
    "fuente": { "enum": ["hook", "git", "github", "orquestador", "compuerta", "mcp", "humano", "derivado", "web", "demonio"] },
    "confirmacion": {
      "type": "object",
      "description": "M9a, ADR-0011: «confirmada» = hecha desde el portátil del dueño (o de los dos dueños, en una conexión), no decidida por una persona.",
      "required": ["valor", "por", "faltan", "de_scaffold", "fuente", "observado_en"],
      "additionalProperties": false,
      "properties": {
        "valor": { "enum": ["confirmada", "sin_confirmar"] },
        "por": { "type": "array", "items": { "type": "string" }, "description": "Personas cuyos commits añadieron una fila con esta clave (sha → persona por los eventos commit)." },
        "faltan": { "type": "array", "items": { "type": "string" }, "description": "Dueños según autoridad.md que aún no la han añadido." },
        "de_scaffold": { "type": "boolean", "description": "La fila estaba en el commit que creó servicios.md." },
        "fuente": { "$ref": "#/$defs/fuente" },
        "observado_en": { "type": "string", "format": "date-time" }
      }
    },
    "texto_o_nada": { "anyOf": [{ "type": "null" }, { "type": "string", "maxLength": 300 }] },
    "dato": {
      "type": "object",
      "required": ["valor", "fuente", "observado_en"],
      "additionalProperties": false,
      "properties": {
        "valor": {},
        "fuente": { "$ref": "#/$defs/fuente" },
        "observado_en": { "type": "string", "format": "date-time" },
        "declarado": { "type": "boolean", "default": false }
      }
    },
    "estado_tarea": { "enum": ["pendiente", "lista", "reclamada", "en_curso", "parada", "en_revision", "integrada", "no_cerrada", "publicada", "cerrada"] },
    "dato_estado": {
      "type": "object",
      "required": ["valor", "fuente", "observado_en"],
      "additionalProperties": false,
      "properties": {
        "valor": { "$ref": "#/$defs/estado_tarea" },
        "fuente": { "$ref": "#/$defs/fuente" },
        "observado_en": { "type": "string", "format": "date-time" },
        "declarado": { "type": "boolean", "default": false }
      }
    },
    "hora_o_nada": { "anyOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }] },
    "cita": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}( · .{1,80})?$",
      "description": "Tras congelar, 2026-10-19, M10 (ADR-0012, decisión 2A): como citan las personas una nota, «AAAA-MM-DD HH:MM» o «AAAA-MM-DD HH:MM · quién»."
    },
    "plazo": {
      "type": "object",
      "description": "Tras congelar, 2026-10-19, M10 (ADR-0013, decisión 2A): el Hasta del plan resuelto a hora absoluta con Inicio: y la zona horaria de equipo.md. valor null = «sin plazo», con su motivo; nunca «a tiempo».",
      "required": ["valor", "texto", "motivo", "fuente", "observado_en"],
      "additionalProperties": false,
      "properties": {
        "valor": { "$ref": "#/$defs/hora_o_nada" },
        "texto": { "$ref": "#/$defs/texto_o_nada", "description": "El Hasta tal cual (heredado de la fila de arriba si la celda va vacía)." },
        "motivo": { "anyOf": [{ "type": "null" }, { "enum": ["vacio", "relativo_sin_inicio", "sin_inicio", "sin_zona", "por_confirmar", "formato"] }] },
        "fuente": { "$ref": "#/$defs/fuente" },
        "observado_en": { "type": "string", "format": "date-time", "description": "Hora del commit de plan.md en origin/main." },
        "declarado": { "type": "boolean", "default": false }
      }
    },
    "franja": {
      "type": "object",
      "description": "Tras congelar, 2026-10-19, M10 (ADR-0013, decisión 4A): la franja planificada, derivada del plan (no es una estimación). valor null con su motivo si no se puede derivar.",
      "required": ["valor", "motivo", "fuente", "observado_en"],
      "additionalProperties": false,
      "properties": {
        "valor": {
          "anyOf": [{ "type": "null" }, {
            "type": "object",
            "required": ["desde", "hasta", "min", "compartida"],
            "additionalProperties": false,
            "properties": {
              "desde": { "type": "string", "format": "date-time" },
              "hasta": { "type": "string", "format": "date-time" },
              "min": { "type": "integer", "minimum": 1, "description": "Minutos de la franja que le tocan: (hasta − desde) / compartida, redondeado hacia arriba." },
              "compartida": { "type": "integer", "minimum": 1, "description": "Filas que se reparten el bloque (las que heredan el mismo Hasta)." }
            }
          }]
        },
        "motivo": { "anyOf": [{ "type": "null" }, { "enum": ["sin_plazo", "sin_inicio", "orden"] }] },
        "fuente": { "$ref": "#/$defs/fuente" },
        "observado_en": { "type": "string", "format": "date-time" },
        "declarado": { "type": "boolean", "default": false }
      }
    },
    "historia": {
      "type": "object",
      "description": "Tras congelar, 2026-10-19, M10 (ADR-0012, decisión 6B; ADR-0013, decisión 5A): reconstruida por el relay desde relay/eventos.jsonl y los eventos de GitHub. Fuente derivado.",
      "required": ["primera_senal", "hecha_en", "trabajo_nuevo_desde", "fuente", "observado_en"],
      "additionalProperties": false,
      "properties": {
        "primera_senal": { "$ref": "#/$defs/hora_o_nada", "description": "Primer paso a en_curso." },
        "hecha_en": { "$ref": "#/$defs/hora_o_nada", "description": "Primer paso a publicada, o a cerrada no declarada." },
        "trabajo_nuevo_desde": { "$ref": "#/$defs/hora_o_nada", "description": "Primer paso a en_curso después de hecha_en, si ahora no está hecha." },
        "fuente": { "$ref": "#/$defs/fuente" },
        "observado_en": { "type": "string", "format": "date-time" }
      }
    },
    "hora_declarada": {
      "type": "object",
      "description": "Tras congelar, 2026-10-19, M10 (ADR-0013, decisiones 1A, 2A y 9A): una hora que declara el equipo en equipo.md, plan.md o criterios.md, con el texto tal cual y su procedencia.",
      "required": ["valor", "texto", "motivo", "donde", "fuente", "observado_en", "declarado"],
      "additionalProperties": false,
      "properties": {
        "nombre": { "$ref": "#/$defs/texto_o_nada", "description": "En los hitos, la columna Qué; en las demás, ausente." },
        "valor": { "$ref": "#/$defs/hora_o_nada" },
        "texto": { "$ref": "#/$defs/texto_o_nada" },
        "confirmar": { "type": "boolean", "description": "La línea lleva «(confirmar)»." },
        "motivo": { "anyOf": [{ "type": "null" }, { "enum": ["sin_dato", "sin_zona", "formato", "dos_horas", "por_confirmar"] }] },
        "donde": { "enum": ["equipo.md", "plan.md", "criterios.md"] },
        "fuente": { "$ref": "#/$defs/fuente" },
        "observado_en": { "type": "string", "format": "date-time", "description": "Hora del commit de ese fichero en origin/main." },
        "declarado": { "const": true }
      }
    },
    "descanso": {
      "type": "object",
      "description": "Tras congelar, 2026-10-19, M10 (ADR-0013, decisión 9A): una línea de «## Descansos» del plan.",
      "required": ["persona", "desde", "hasta", "texto", "motivo", "fuente", "observado_en", "declarado"],
      "additionalProperties": false,
      "properties": {
        "persona": { "$ref": "#/$defs/texto_o_nada", "description": "null = todo el equipo." },
        "desde": { "$ref": "#/$defs/hora_o_nada" },
        "hasta": { "$ref": "#/$defs/hora_o_nada" },
        "texto": { "type": "string", "maxLength": 300 },
        "motivo": { "anyOf": [{ "type": "null" }, { "enum": ["formato", "sin_inicio", "sin_zona"] }] },
        "fuente": { "$ref": "#/$defs/fuente" },
        "observado_en": { "type": "string", "format": "date-time" },
        "declarado": { "const": true }
      }
    },
    "fuerza": {
      "type": "object",
      "required": ["tipo", "texto"],
      "additionalProperties": false,
      "properties": {
        "tipo": { "enum": ["dato", "palabra", "comentario", "sin_precisar"] },
        "texto": { "type": "string", "maxLength": 40, "description": "Tal como la anotó el equipo («obligatorio», «se valora»…)." }
      }
    },
    "nota": {
      "type": "object",
      "description": "Tras congelar, 2026-10-19, M10 (ADR-0012): una nota de .hackathon/criterios.md de origin/main. Todo su texto es dato del equipo (constitución V).",
      "required": ["clave", "cita", "hora", "quien", "papel", "donde", "dijo", "literal", "fuerza", "afecta_a", "anotado_por", "corrige", "fuente", "observado_en", "declarado"],
      "additionalProperties": false,
      "properties": {
        "clave": { "type": "string", "pattern": "^[0-9a-f]{12}$", "description": "Decisión 2A: 12 hex del sha256 de la cabecera, «Qué dijo» y «Anotado por» (api.md §11)." },
        "cita": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}$" },
        "hora": { "$ref": "#/$defs/hora_o_nada", "description": "La cita con la zona horaria de equipo.md; null sin zona." },
        "quien": { "$ref": "#/$defs/texto_o_nada" },
        "papel": { "$ref": "#/$defs/texto_o_nada" },
        "donde": { "$ref": "#/$defs/texto_o_nada" },
        "dijo": { "type": "string", "maxLength": 500 },
        "literal": { "type": "boolean" },
        "fuerza": { "$ref": "#/$defs/fuerza" },
        "afecta_a": { "$ref": "#/$defs/texto_o_nada" },
        "anotado_por": { "$ref": "#/$defs/texto_o_nada" },
        "corrige": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/cita" }], "description": "«corrige la nota del <fecha hora>», tal como lo escribe /hack-note." },
        "fuente": { "$ref": "#/$defs/fuente" },
        "observado_en": { "type": "string", "format": "date-time", "description": "Hora del commit de criterios.md en origin/main." },
        "declarado": { "const": true }
      }
    },
    "tarjeta_m10": {
      "type": "object",
      "description": "La tarjeta de la vista (api.md §6: id, titulo, dueno, estado, etiqueta, fuente, observado_en…), más viejo. Abierta: la define proyeccion.tarjeta.",
      "required": ["id", "estado", "fuente", "observado_en", "viejo"],
      "properties": {
        "id": { "type": "string", "pattern": "^T[0-9]{2,3}$" },
        "estado": { "$ref": "#/$defs/estado_tarea" },
        "fuente": { "$ref": "#/$defs/fuente" },
        "observado_en": { "type": "string", "format": "date-time" },
        "viejo": { "type": "boolean" }
      }
    },
    "vista_jurado": {
      "type": "object",
      "description": "Tras congelar, 2026-10-19, M10 (ADR-0012; api.md §11): el bloque jurado de proyeccion.vista, solo con vista_jurado: sí. No es un campo de estado.json: se define aquí para validar la vista de ejemplo y la de los guiones.",
      "required": ["observado_en", "fuente", "viejo", "cuenta", "notas", "sin_nota", "resumen"],
      "additionalProperties": false,
      "properties": {
        "observado_en": { "type": "string", "format": "date-time" },
        "fuente": { "$ref": "#/$defs/fuente" },
        "viejo": { "type": "boolean" },
        "fichero": { "type": "string", "enum": ["ok", "sin fichero", "mal formado"] },
        "cuenta": {
          "type": "object",
          "description": "Tras congelar, 2026-10-19, M10, issue #46 (ajuste 2 de ADR-0012): sin_cubrir = sin_tarea + ambiguas + planificadas + en_curso + en_pitch (todo lo no cubierto, sin las corregidas, que solo van en corregidas). Una ambigua no cuenta en sin_tarea.",
          "required": ["notas", "corregidas", "cubiertas", "sin_cubrir", "sin_tarea", "ambiguas", "en_pitch", "sin_cubrir_por_fuerza"],
          "additionalProperties": false,
          "properties": {
            "notas": { "type": "integer", "minimum": 0 },
            "corregidas": { "type": "integer", "minimum": 0 },
            "cubiertas": { "type": "integer", "minimum": 0 },
            "sin_cubrir": { "type": "integer", "minimum": 0 },
            "sin_tarea": { "type": "integer", "minimum": 0 },
            "ambiguas": { "type": "integer", "minimum": 0 },
            "planificadas": { "type": "integer", "minimum": 0, "description": "Enlazadas a tareas que no han empezado (ninguna con historia.primera_senal)." },
            "en_curso": { "type": "integer", "minimum": 0, "description": "Enlazadas a tareas sin hacer, alguna con señales." },
            "en_pitch": { "type": "integer", "minimum": 0 },
            "declaradas": { "type": "integer", "minimum": 0, "description": "TRANSITORIO (issue #46): se quita al adaptar el código. Lo sustituyen planificadas y en_curso." },
            "sin_cubrir_por_fuerza": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["texto", "n"],
                "additionalProperties": false,
                "properties": { "texto": { "type": "string", "maxLength": 40 }, "n": { "type": "integer", "minimum": 1 } }
              }
            }
          }
        },
        "notas": {
          "type": "array",
          "description": "Ya ordenadas: las sin cubrir por fuerza y luego por hora; después las cubiertas; al final las corregidas.",
          "items": {
            "type": "object",
            "required": ["nota", "cobertura", "corregida_por", "trabajo_nuevo_desde", "tareas", "evidencias", "pitch"],
            "additionalProperties": false,
            "properties": {
              "nota": { "$ref": "#/$defs/nota" },
              "cobertura": {
                "type": "object",
                "required": ["valor", "fuente", "observado_en", "viejo"],
                "additionalProperties": false,
                "properties": {
                  "valor": { "anyOf": [
                    { "enum": ["sin_tarea", "ambigua", "planificada", "en_curso", "en_pitch", "cubierta"], "description": "Tras congelar, 2026-10-19, M10, issue #46 (ajuste 2 de ADR-0012): planificada = sus tareas no han empezado; en_curso = alguna tiene señales." },
                    { "enum": ["declarada"], "description": "TRANSITORIO (issue #46): se quita al adaptar el código. Lo sustituyen planificada y en_curso." }
                  ] },
                  "fuente": { "$ref": "#/$defs/fuente" },
                  "observado_en": { "type": "string", "format": "date-time" },
                  "viejo": { "type": "boolean" }
                }
              },
              "corregida_por": { "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{12}$" }] },
              "trabajo_nuevo_desde": { "$ref": "#/$defs/hora_o_nada", "description": "Decisión 6B: sigue cubierta, con el trabajo nuevo desde esta hora." },
              "tareas": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["tarjeta", "enlace"],
                  "additionalProperties": false,
                  "properties": {
                    "tarjeta": { "$ref": "#/$defs/tarjeta_m10" },
                    "enlace": {
                      "type": "object",
                      "required": ["cita", "ambiguo", "donde", "fuente", "observado_en", "declarado"],
                      "additionalProperties": false,
                      "properties": {
                        "cita": { "$ref": "#/$defs/cita" },
                        "ambiguo": { "type": "boolean" },
                        "donde": { "const": "plan.md" },
                        "fuente": { "$ref": "#/$defs/fuente" },
                        "observado_en": { "type": "string", "format": "date-time" },
                        "declarado": { "const": true }
                      }
                    }
                  }
                }
              },
              "evidencias": {
                "type": "array",
                "description": "Se enseñan siempre que existan, aunque la nota no esté cubierta. La Prueba es evidencia, no condición (decisión 4A).",
                "items": {
                  "type": "object",
                  "required": ["tipo", "tarea", "valor", "fuente", "observado_en", "viejo"],
                  "additionalProperties": false,
                  "properties": {
                    "tipo": { "enum": ["commit", "fusion", "prueba"] },
                    "tarea": { "type": "string", "pattern": "^T[0-9]{2,3}$" },
                    "valor": { "type": "string", "maxLength": 60, "description": "El sha (commit, fusión) o pasa | falla (prueba)." },
                    "conexion": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
                    "fuente": { "$ref": "#/$defs/fuente" },
                    "observado_en": { "type": "string", "format": "date-time" },
                    "viejo": { "type": "boolean" }
                  }
                }
              },
              "pitch": {
                "description": "Decisión 5B: la cita en .hackathon/pitch.md, como declarado; nunca hace la nota cubierta.",
                "anyOf": [{ "type": "null" }, {
                  "type": "object",
                  "required": ["fuente", "observado_en", "declarado"],
                  "additionalProperties": false,
                  "properties": {
                    "fuente": { "$ref": "#/$defs/fuente" },
                    "observado_en": { "type": "string", "format": "date-time" },
                    "declarado": { "const": true }
                  }
                }]
              }
            }
          }
        },
        "sin_nota": {
          "type": "array",
          "description": "Citas de la etiqueta (criterios: …) que no casan con ninguna nota: enlaces rotos, como declarado (plan).",
          "items": {
            "type": "object",
            "required": ["tarea", "cita", "fuente", "observado_en", "declarado"],
            "additionalProperties": false,
            "properties": {
              "tarea": { "type": "string", "pattern": "^T[0-9]{2,3}$" },
              "cita": { "$ref": "#/$defs/cita" },
              "fuente": { "$ref": "#/$defs/fuente" },
              "observado_en": { "type": "string", "format": "date-time" },
              "declarado": { "const": true }
            }
          }
        },
        "resumen": { "type": "string", "maxLength": 160, "description": "Decisión 7B: la línea de estado-equipo.md, sin el «- » ni la hora." }
      }
    },
    "vista_ruta": {
      "type": "object",
      "description": "Tras congelar, 2026-10-19, M10 (ADR-0013; api.md §11): el bloque ruta de proyeccion.vista, solo con ruta_critica: sí. No es un campo de estado.json.",
      "required": ["observado_en", "fuente", "viejo", "dato_mas_viejo", "objetivo", "otras_entregas", "veredicto", "estimacion", "base", "hechos", "cadena", "sin_plazo", "fuera_de_entrega", "hitos", "descansos", "resumen"],
      "additionalProperties": false,
      "properties": {
        "observado_en": { "type": "string", "format": "date-time" },
        "fuente": { "$ref": "#/$defs/fuente" },
        "viejo": { "type": "boolean" },
        "dato_mas_viejo": { "$ref": "#/$defs/hora_o_nada" },
        "objetivo": {
          "description": "Decisión 1A y diseño: la entrega de equipo.md (la congelación es un hito). null sin equipo.md legible.",
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/hora_declarada" }]
        },
        "otras_entregas": { "type": "array", "items": { "$ref": "#/$defs/hora_declarada" }, "description": "Las de Hitos o de notas dato que no coinciden con el objetivo: se enseñan al lado, como discrepancia, y no quitan la estimación (decisión 1A)." },
        "veredicto": {
          "type": "object",
          "required": ["valor", "motivos", "gravedad", "fuente", "observado_en"],
          "additionalProperties": false,
          "properties": {
            "valor": { "enum": ["a_tiempo", "justo", "no_llega", "sin_estimacion"] },
            "motivos": {
              "type": "array",
              "items": { "anyOf": [
                { "enum": ["sin_entrega", "entrega_doble", "ciclo", "pocos_datos"] },
                { "enum": ["sin_plazo"], "description": "TRANSITORIO (issue #46): se quita al adaptar el código. Tras el ajuste 1 de ADR-0013, una tarea sin plazo va a sin_plazo[] y no quita la estimación." }
              ] },
              "description": "sin_entrega: equipo.md sin Entrega:, ilegible o sin resolver; entrega_doble: esa línea trae dos horas. Las otras_entregas que no coinciden no quitan la estimación (decisión 1A); una tarea abierta sin plazo, tampoco (ajuste 1, issue #46)."
            },
            "gravedad": { "enum": ["ninguna", "ambar", "gris"], "description": "«no llega» es ámbar: el rojo es solo para hechos." },
            "fuente": { "$ref": "#/$defs/fuente" },
            "observado_en": { "type": "string", "format": "date-time" }
          }
        },
        "estimacion": {
          "description": "null salvo con veredicto a_tiempo, justo o no_llega. Siempre un rango, nunca una sola hora.",
          "anyOf": [{ "type": "null" }, {
            "type": "object",
            "required": ["temprano", "tarde", "margen_min", "margen_max"],
            "additionalProperties": false,
            "properties": {
              "temprano": { "type": "string", "format": "date-time" },
              "tarde": { "type": "string", "format": "date-time" },
              "margen_min": { "type": "integer", "description": "Entrega − tarde, en minutos (negativo: no llega en el peor caso)." },
              "margen_max": { "type": "integer", "description": "Entrega − temprano, en minutos." }
            }
          }]
        },
        "base": {
          "type": "object",
          "required": ["minimo", "personas"],
          "additionalProperties": false,
          "properties": {
            "minimo": { "const": 3, "description": "Umbral de «sin cifra», fijo en el contrato." },
            "desde": { "$ref": "#/$defs/hora_o_nada" },
            "personas": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["persona", "n", "ritmo_min", "ritmo_max", "fuente", "observado_en"],
                "additionalProperties": false,
                "properties": {
                  "persona": { "type": "string" },
                  "n": { "type": "integer", "minimum": 0 },
                  "ritmo_min": { "anyOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }], "description": "Duración real ÷ franja, en %, de la más rápida de sus tareas medidas; null con n < 3." },
                  "ritmo_max": { "anyOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }] },

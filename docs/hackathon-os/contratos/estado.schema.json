          "historia": { "$ref": "#/$defs/historia", "description": "Tras congelar, 2026-10-19, M10: con vista_jurado: sí o ruta_critica: sí." },
          "criterios": { "$ref": "#/$defs/dato", "description": "Tras congelar, 2026-10-19, M10 (ADR-0012, decisión 3A): valor = lista de citas de la etiqueta (criterios: …) de su fila de plan.md; fuente git, declarado. Solo con vista_jurado: sí." },
          "conexiones": { "$ref": "#/$defs/dato", "description": "Tras congelar, 2026-10-19, M10 (ADR-0012, decisión 4A): valor = claves de las conexiones de servicios.md cuya Prueba aparece tal cual en «Cómo se comprueba»; fuente git, declarado. Solo con vista_jurado: sí." }

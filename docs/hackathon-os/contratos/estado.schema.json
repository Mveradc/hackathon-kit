        "otras_entregas": { "type": "array", "items": { "$ref": "#/$defs/hora_declarada" }, "description": "La fila de Hitos que contiene «Entrega» y las notas de fuerza dato que afectan a la entrega, para compararlas." },
        "hitos": { "type": "array", "items": { "$ref": "#/$defs/hora_declarada" }, "description": "La tabla «Hitos del equipo» del plan (la congelación es uno)." },
        "descansos": { "type": "array", "items": { "$ref": "#/$defs/descanso" } }
      }
    }

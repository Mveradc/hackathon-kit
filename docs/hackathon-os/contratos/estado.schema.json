{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hackathon-kit/os/estado/v1",
  "title": "Estado proyectado del equipo (v1)",
  "description": "Lo calcula el relay. Web, estado-equipo.md y MCP salen solo de aquí. Todo dato observado va como Dato {valor, fuente, observado_en}. Los estados de tarea son identificadores; las vistas muestran su etiqueta legible.",
  "type": "object",
  "required": ["v", "generado_en", "fuentes", "personas", "tareas", "colisiones"],
  "additionalProperties": false,
  "$defs": {
    "fuente": { "enum": ["hook", "git", "github", "orquestador", "compuerta", "mcp", "humano", "derivado", "web", "demonio"] },
    "confirmacion": {
      "type": "object",
      "description": "M9a, ADR-0011: «confirmada» = hecha desde el portátil del dueño (o de los dos dueños, en una conexión), no decidida por una persona.",
      "required": ["valor", "por", "faltan", "de_scaffold", "fuente", "observado_en"],
      "additionalProperties": false,
      "properties": {
        "valor": { "enum": ["confirmada", "sin_confirmar"] },
        "por": { "type": "array", "items": { "type": "string" }, "description": "Personas cuyos commits añadieron una fila con esta clave (sha → persona por los eventos commit)." },
        "faltan": { "type": "array", "items": { "type": "string" }, "description": "Dueños según autoridad.md que aún no la han añadido." },
        "de_scaffold": { "type": "boolean", "description": "La fila estaba en el commit que creó servicios.md." },
        "fuente": { "$ref": "#/$defs/fuente" },
        "observado_en": { "type": "string", "format": "date-time" }
      }
    },
    "texto_o_nada": { "anyOf": [{ "type": "null" }, { "type": "string", "maxLength": 300 }] },
    "dato": {
      "type": "object",
      "required": ["valor", "fuente", "observado_en"],
      "additionalProperties": false,
      "properties": {
        "valor": {},
        "fuente": { "$ref": "#/$defs/fuente" },
        "observado_en": { "type": "string", "format": "date-time" },
        "declarado": { "type": "boolean", "default": false }
      }
    },
    "estado_tarea": { "enum": ["pendiente", "lista", "reclamada", "en_curso", "parada", "en_revision", "integrada", "no_cerrada", "publicada", "cerrada"] },
    "dato_estado": {
      "type": "object",
      "required": ["valor", "fuente", "observado_en"],
      "additionalProperties": false,
      "properties": {
        "valor": { "$ref": "#/$defs/estado_tarea" },
        "fuente": { "$ref": "#/$defs/fuente" },
        "observado_en": { "type": "string", "format": "date-time" },
        "declarado": { "type": "boolean", "default": false }
      }
    }
  },
  "properties": {
    "v": { "const": 1 },
    "generado_en": { "type": "string", "format": "date-time" },
    "fuentes": {
      "type": "object",
      "description": "Salud de cada fuente: cuándo se leyó por última vez con éxito.",
      "additionalProperties": false,
      "properties": {
        "relay": { "$ref": "#/$defs/dato" },
        "github": { "$ref": "#/$defs/dato" },
        "git": { "$ref": "#/$defs/dato" }
      }
    },
    "personas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["persona", "nombre", "actores"],
        "additionalProperties": false,
        "properties": {
          "persona": { "type": "string" },
          "nombre": { "type": "string" },
          "actores": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["papel", "activo", "ultimo_latido"],
              "additionalProperties": false,
              "properties": {
                "papel": { "enum": ["principal", "orquestador", "worker", "revisor", "humano"] },
                "sesion": { "type": "string" },
                "agente": { "type": "string" },
                "worktree": { "type": "string" },
                "tarea": { "$ref": "#/$defs/dato" },
                "activo": { "type": "boolean" },
                "ultimo_latido": { "type": "string", "format": "date-time" },
                "ficheros": { "$ref": "#/$defs/dato", "description": "valor: lista de rutas cambiadas respecto de origin/main" }
              }
            }
          }
        }
      }
    },
    "tareas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "titulo", "dueno", "estado"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^T[0-9]{2,3}$" },
          "titulo": { "type": "string" },
          "bloque": { "type": "string" },
          "dueno": { "type": "string" },
          "issue": { "type": "integer" },
          "depende_de": { "type": "array", "items": { "type": "string" } },
          "cumplidas_por_cierre": { "type": "array", "items": { "type": "string", "pattern": "^T[0-9]{2,3}$" }, "description": "Dependencias cumplidas porque alguien del equipo cerró su issue sin que estén publicadas (se muestra «⚑ T02 cerrada a mano»)." },
          "estado": { "$ref": "#/$defs/dato_estado", "description": "Siempre el derivado de las señales (diseno.md §5)." },
          "declarado": {
            "description": "Estado forzado por una persona, si lo hay (se muestra con ⚑ junto al derivado).",
            "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/dato_estado" }]
          },
          "fusion": { "type": "string" },
          "evidencia": { "type": "string", "description": "Comprobación del revisor o commit que la publica." }
        }
      }
    },
    "sin_tarea": {
      "type": "array",
      "description": "Actividad que no corresponde a ninguna tarea (R-15).",
      "items": {
        "type": "object",
        "required": ["persona", "que", "observado_en"],
        "additionalProperties": false,
        "properties": { "persona": { "type": "string" }, "que": { "type": "string" }, "observado_en": { "type": "string", "format": "date-time" } }
      }
    },
    "discrepancias": {
      "type": "array",
      "description": "Señales que el motor de estados ignora o en las que gana git, para que no se pierdan en silencio (constitución II). Una entrada por (tipo, tarea, persona), con su contador.",
      "items": {
        "type": "object",
        "required": ["tipo", "detalle", "veces", "primera_vez", "ultima_vez"],
        "additionalProperties": false,
        "properties": {
          "tipo": { "enum": ["hook_frente_a_git", "veredicto_sha", "dependencia_inexistente", "fuera_del_equipo", "actividad_ajena", "atribucion_ambigua", "linea_corrupta", "dependencias_distintas", "issue_duplicado"] },
          "tarea": { "type": "string", "pattern": "^T[0-9]{2,3}$" },
          "persona": { "type": "string", "description": "Quién produjo la señal (en fuera_del_equipo, la cuenta de fuera)." },
          "detalle": { "type": "string", "maxLength": 300, "description": "El de la última vez." },
          "veces": { "type": "integer", "minimum": 1 },
          "primera_vez": { "type": "string", "format": "date-time" },
          "ultima_vez": { "type": "string", "format": "date-time" }
        }
      }
    },
    "colisiones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "nivel", "gravedad", "personas", "rutas", "observado_en"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "nivel": { "enum": ["1", "2", "2b", "3", "reserva"] },
          "gravedad": { "enum": ["amarillo", "rojo"] },
          "personas": { "type": "array", "items": { "type": "string" } },
          "rutas": { "type": "array", "items": { "type": "string" } },
          "contrato": { "type": "string" },
          "observado_en": { "type": "string", "format": "date-time" }
        }
      }
    },
    "reservas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rutas", "persona", "hasta", "modo"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "description": "El del evento reserva (M8g): lo usan liberar y el aviso de una vez por sesión." },
          "rutas": { "type": "array", "items": { "type": "string" } },
          "persona": { "type": "string" },
          "actor": { "type": "string" },
          "hasta": { "type": "string", "format": "date-time" },
          "modo": { "enum": ["exclusiva", "compartida"] }
        }
      }
    },
    "novedades": {
      "type": "array",
      "description": "Decisiones (decisiones.md, issues hk:acordado) y criterios (criterios.md) con su hora, para los deltas.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": { "tipo": { "enum": ["decision", "criterio", "escalado"] }, "resumen": { "type": "string", "maxLength": 200 }, "autor": { "type": "string" }, "observado_en": { "type": "string", "format": "date-time" } }
      }
    },
    "servicios": {
      "type": "object",
      "description": "M9a (ADR-0011, api.md §3 y §10): solo con web_nueva: sí y .hackathon/servicios.md en origin/main del clon del relay. Los textos (nombres, comandos, contratos) son dato del equipo.",
      "required": ["fichero", "lista", "conexiones", "propuestas", "fuera", "desajustes"],
      "additionalProperties": false,
      "properties": {
        "fichero": { "$ref": "#/$defs/dato", "description": "valor: ok | mal formado; observado_en: hora del commit de servicios.md en origin/main." },
        "lista": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["clave", "nombre", "carpeta", "puerto", "arranque", "salud", "dueno", "dueno_autoridad", "confirmacion", "comprobado"],
            "additionalProperties": false,
            "properties": {
              "clave": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
              "nombre": { "type": "string", "maxLength": 40 },
              "carpeta": { "type": "string", "maxLength": 300 },
              "puerto": { "anyOf": [{ "type": "null" }, { "type": "integer", "minimum": 1, "maximum": 65535 }] },
              "arranque": { "$ref": "#/$defs/texto_o_nada" },
              "salud": { "$ref": "#/$defs/texto_o_nada" },
              "dueno": { "$ref": "#/$defs/texto_o_nada", "description": "La columna Dueño, tal cual (dato)." },
              "dueno_autoridad": { "$ref": "#/$defs/texto_o_nada", "description": "La persona cuyas carpetas de autoridad.md contienen la carpeta; null si ninguna o más de una." },
              "confirmacion": { "$ref": "#/$defs/confirmacion" },
              "comprobado": {
                "description": "Lo último que emitió el demonio de su dueño (servicio.estado): valor {escucha, salud}. null si nunca se comprobó.",
                "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/dato" }]
              }
            }
          }
        },
        "conexiones": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["clave", "de", "a", "contrato", "prueba", "duenos", "confirmacion", "resultado"],
            "additionalProperties": false,
            "properties": {
              "clave": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
              "de": { "type": "string", "maxLength": 40 },
              "a": { "type": "string", "maxLength": 40 },
              "contrato": { "$ref": "#/$defs/texto_o_nada" },
              "prueba": { "$ref": "#/$defs/texto_o_nada", "description": "El comando, tal cual; el OS nunca lo ejecuta." },
              "duenos": { "type": "array", "items": { "type": "string" }, "description": "Dueños de los dos extremos según autoridad.md." },
              "confirmacion": { "$ref": "#/$defs/confirmacion" },
              "resultado": {
                "description": "El último resultado de su Prueba (evento prueba, por comando_sha): valor pasa | falla, fuente hook. null si nadie la ha corrido.",
                "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/dato" }]
              }
            }
          }
        },
        "propuestas": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tipo", "clave", "campos", "autor_declarado", "hora_declarada", "autor_git", "observado_en"],
            "additionalProperties": false,
            "properties": {
              "tipo": { "enum": ["servicio", "conexion"], "description": "De qué tabla viene: «## Propuestas de servicios» o «## Propuestas de conexiones» (api.md §10)." },
              "clave": { "type": "string", "pattern": "^[0-9a-f]{12}$", "description": "La de la fila que propone (sus columnas sin Autor ni Hora)." },
              "campos": {
                "type": "object",
                "description": "Las columnas de la fila propuesta, con los nombres de lista (servicio) o de conexiones (conexión); sin Autor ni Hora.",
                "additionalProperties": false,
                "properties": {
                  "nombre": { "type": "string", "maxLength": 40 },
                  "carpeta": { "type": "string", "maxLength": 300 },
                  "puerto": { "anyOf": [{ "type": "null" }, { "type": "integer", "minimum": 1, "maximum": 65535 }] },
                  "arranque": { "$ref": "#/$defs/texto_o_nada" },
                  "salud": { "$ref": "#/$defs/texto_o_nada" },
                  "dueno": { "$ref": "#/$defs/texto_o_nada" },
                  "de": { "type": "string", "maxLength": 40 },
                  "a": { "type": "string", "maxLength": 40 },
                  "contrato": { "$ref": "#/$defs/texto_o_nada" },
                  "prueba": { "$ref": "#/$defs/texto_o_nada" }
                }
              },
              "duenos": { "type": "array", "items": { "type": "string" }, "description": "Quién la confirma según autoridad.md: el dueño de la carpeta (servicio) o los de los dos extremos (conexión). Opcional (K-97)." },
              "autor_declarado": { "$ref": "#/$defs/texto_o_nada" },
              "hora_declarada": { "$ref": "#/$defs/texto_o_nada" },
              "autor_git": { "$ref": "#/$defs/texto_o_nada", "description": "La persona del commit que la añadió; null si el sha no es de ningún evento commit." },
              "observado_en": { "type": "string", "format": "date-time" }
            }
          }
        },
        "fuera": { "type": "array", "items": { "type": "string" }, "description": "«Fuera de servicios:» más lo que siempre está fuera (api.md §10)." },
        "desajustes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tipo", "detalle", "observado_en", "fuente"],
            "additionalProperties": false,
            "properties": {
              "tipo": { "enum": ["puerto_sin_respuesta", "salud_falla", "formato_invalido", "codigo_fuera", "prueba_falla", "dueno_distinto", "contrato_inexistente"] },
              "clave": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
              "personas": { "type": "array", "items": { "type": "string" }, "description": "A quién afecta (para la sección de estado-equipo.md)." },
              "rutas": { "type": "array", "items": { "type": "string" } },
              "detalle": { "type": "string", "maxLength": 300 },
              "observado_en": { "type": "string", "format": "date-time" },
              "fuente": { "$ref": "#/$defs/fuente" }
            }
          }
        }
      }
    }
  }
}

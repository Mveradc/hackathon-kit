{
  "description": "Coordinación entre agentes (opcional): reinyecta estado y buzón al empezar o reanudar la sesión. Ningún agente publica «hk confirmo». Orquestador (M7): no edita código; compuerta de evidencias de los workers. Hackathon OS (M8, opcional): emite.sh y arbol.sh escriben eventos locales, delta.sh inyecta el estado del equipo y reserva.sh avisa (sin bloquear) de los ficheros reservados por otras personas, solo con .hackathon/os.md activo.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit|Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/orquestador/solo-orquestar.sh\"", "timeout": 10 }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/coordinacion/sin-confirmo.sh\"", "timeout": 10 }
        ]
      },
      {
        "matcher": "SubagentHandback",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/orquestador/compuerta.sh\"", "timeout": 20 }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell|Agent",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/os/emite.sh\"", "timeout": 10, "async": true }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/os/reserva.sh\"", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell|Agent",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/os/emite.sh\"", "timeout": 10, "async": true }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/os/arbol.sh\"", "timeout": 20, "async": true }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/os/arbol.sh\"", "timeout": 20, "async": true }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/os/emite.sh\"", "timeout": 10, "async": true },
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/os/reserva.sh\"", "timeout": 5 }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/orquestador/compuerta.sh\"", "timeout": 20 },
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/os/emite.sh\"", "timeout": 10, "async": true },
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/os/arbol.sh\"", "timeout": 20, "async": true }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/coordinacion/sesion.sh\"", "timeout": 15 },
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/os/emite.sh\"", "timeout": 10, "async": true }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/os/delta.sh\"", "timeout": 10 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}/scripts/os/emite.sh\"", "timeout": 10 }
        ]
      }
    ]
  }
}
